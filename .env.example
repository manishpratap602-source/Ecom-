# Environment variables (copy to .env in development)

# Postgres connection
DATABASE_URL=postgresql://user:password@localhost:5432/ecom_db?schema=public

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_this_to_a_random_value

# Google OAuth (for NextAuth)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# UPI (for deeplink flow)
# The payee VPA (Virtual Payment Address), e.g. merchant@upi
UPI_PAYEE_VPA=merchant@upi
# Payee name (merchant display name)
UPI_PAYEE_NAME=YourMerchantName

# SendGrid (optional)
SENDGRID_API_KEY=

# Image / file storage (optional)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
