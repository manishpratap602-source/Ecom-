generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String? // if using credentials
  role      Role     @default(USER)
  orders    Order[]
  createdAt DateTime @default(now())
}

model Product {
  id          String   @id @default(cuid())
  title       String
  description String?
  price       Int      // cents
  sku         String?  @unique
  inventory   Inventory?
  reviews     Review[]
  createdAt   DateTime @default(now())
}

model Inventory {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id])
  productId String  @unique
  stock     Int     @default(0)
  updatedAt DateTime @updatedAt
}

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  percentOff  Int?     // e.g., 10 = 10%
  amountOff   Int?     // flat amount in cents
  expiresAt   DateTime?
  maxUses      Int?
  createdAt   DateTime @default(now())
}

model ShippingRate {
  id        String  @id @default(cuid())
  name      String
  price     Int
  region    String?
  createdAt DateTime @default(now())
}

model Review {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id])
  productId String
  author    User?   @relation(fields: [authorId], references: [id])
  authorId  String?
  rating    Int
  body      String?
  published Boolean @default(false)
  createdAt DateTime @default(now())
}

model Order {
  id        String      @id @default(cuid())
  user      User?       @relation(fields: [userId], references: [id])
  userId    String?
  items     OrderItem[]
  total     Int
  currency  String      @default("INR")
  paid      Boolean     @default(false)
  createdAt DateTime    @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   String
  productId String
  title     String
  unitPrice Int
  quantity  Int
}
